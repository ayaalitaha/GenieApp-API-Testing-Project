                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(202);\r",
                  "});\r",
                  "\r",
                  "const responseData = pm.response.json();\r",
                  "pm.test(\"verify update profile response status\", function () {\r",
                  "    pm.expect(responseData.message).to.eql(\"Updated\");\r",
                  "    pm.expect(responseData.error).to.eql(false);\r",
                  "    pm.expect(responseData.code).to.eql(202);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Verify updated user profile data integrity\", function () {\r",
                  "    const updatedUser = responseData.results;\r",
                  "    pm.expect(updatedUser).to.be.an('object');\r",
                  "    pm.expect(updatedUser).to.have.property('id');\r",
                  "    pm.expect(updatedUser.full_name).to.eql(\"leen\");\r",
                  "    pm.expect(updatedUser.photo_url).to.not.be.empty;\r",
                  "    pm.expect(updatedUser.photo_url).to.include('/images/users/');\r",
                  "    console.log(`Profile updated successfully for User: ${updatedUser.full_name} (ID: ${updatedUser.id}) `);\r",
                  "});"

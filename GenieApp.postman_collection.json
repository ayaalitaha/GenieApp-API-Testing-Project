        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"Response time is less than 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "const responseData = pm.response.json();\r",
                  "pm.test(\"verify sign up response structure'\", function () {\r",
                  "    pm.expect(responseData.message).to.eql(\"success\");\r",
                  "    pm.expect(responseData.error).to.eql(false);\r",
                  "    pm.expect(responseData.code).to.eql(200);\r",
                  "    pm.expect(responseData.results).to.have.property(\"id\");\r",
                  "});\r",
                  "pm.test(\"save token and user info to environment\", function () {\r",
                  "    if(responseData.results && responseData.results.token){\r",
                  "        pm.environment.set(\"token\", responseData.results.token);\r",
                  "        pm.environment.set(\"user_id\", responseData.results.id);\r",
                  "        pm.environment.set(\"email\" , responseData.results.email);\r",
                  "         pm.environment.set(\"phone_number\" , responseData.results.phone_number);\r",
                  "        console.log(\"token and user_id have been saved successfully!\");\r",
                  "    }\r",
                  "    else{\r",
                  "        pm.expect.fail(\"token not found in the response\");\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }

          "name": "Best Offers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const responseData = pm.response.json();\r",
                  "pm.test(\"verift response status\", function () {\r",
                  "\r",
                  "    pm.expect(responseData.message).to.eql(\"success\");\r",
                  "    pm.expect(responseData.error).to.eql(false);\r",
                  "    pm.expect(responseData.code).to.eql(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"verift pagination details\", function () {\r",
                  "\r",
                  "    pm.expect(responseData.results.page).to.eql(1);\r",
                  "    pm.expect(responseData.results.limit).to.eql(10);\r",
                  "    pm.expect(responseData.results.total).to.be.a('number');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Verify best offers list and data integrity\", function () {\r",
                  "    const offersList = responseData.results.data;\r",
                  "    pm.expect(offersList).to.be.an('array');\r",
                  "    pm.expect(offersList.length).to.be.at.most(responseData.results.limit);\r",
                  "    if (offersList.length > 0) {\r",
                  "        const firstOffer = offersList[0];\r",
                  "        pm.expect(firstOffer).to.have.property('id');\r",
                  "        pm.expect(firstOffer).to.have.property('title');\r",
                  "        pm.expect(firstOffer).to.have.property('original_price');\r",
                  "        pm.expect(firstOffer).to.have.property('offer_price');\r",
                  "        pm.expect(firstOffer).to.have.property('discount_value');\r",
                  "        pm.expect(firstOffer.offer_price).to.be.a('number');\r",
                  "        pm.expect(firstOffer.original_price).to.be.a('number');\r",
                  "    }\r",
                  "    console.log(`Verified ${offersList.length} best offers on this page`);\r",
                  "});\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  ""

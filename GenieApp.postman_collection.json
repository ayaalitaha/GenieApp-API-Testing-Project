          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "const responseData = pm.response.json();\r",
                  "pm.test(\"Verify profile response basic structure\", function () {\r",
                  "    pm.expect(responseData.message).to.eql(\"success\");\r",
                  "    pm.expect(responseData.error).to.be.false;\r",
                  "    pm.expect(responseData.code).to.eql(200);\r",
                  "});\r",
                  "pm.test(\"Verify user profile data integrity\", function () {\r",
                  "    const userData = responseData.results;\r",
                  "    pm.expect(userData).to.be.an('object');\r",
                  "    pm.expect(userData).to.have.property('id');\r",
                  "    pm.expect(userData).to.have.property('email');\r",
                  "    pm.expect(userData.email).to.include('@');\r",
                  "    if (userData.id) {\r",
                  "        pm.environment.set(\"current_user_id\", userData.id);\r",
                  "    }\r",
                  "    console.log(`Successfully verified profile for User ID: ${userData.id} `);\r",
                  "});"
                ],

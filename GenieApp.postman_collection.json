        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  " pm.test(\"Status code is 200\", function () {\r",
                  "        pm.response.to.have.status(200);\r",
                  "    });\r",
                  " \r",
                  " const responseData = pm.response.json();\r",
                  " pm.test(\"verify login success status\", function(){\r",
                  "    pm.expect(responseData.message).to.eql(\"success\");\r",
                  "    pm.expect(responseData.error).to.eql(false);\r",
                  " });\r",
                  "\r",
                  " pm.test(\"update access token in environment\", function(){\r",
                  "   if (responseData.results && responseData.results.token) {\r",
                  "         pm.environment.set(\"token\", responseData.results.token);\r",
                  "         console.log(\"Login Token updated successfully\");\r",
                  "    } else {\r",
                  "         pm.expect.fail(\"Token missing from login response\");\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
